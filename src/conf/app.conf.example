#配置模板。首次部署时由 control 复制为同目录的 app.conf（见 control 的 ensure_conf），
#之后升级不会再覆盖 app.conf——发布包与镜像里都只带这份 .example，不带 app.conf。
#本文件入 git，请勿在此填写真实凭据；真实凭据只写进 app.conf（已被 .gitignore 忽略）。
appname = gopub
httpport = 8080
runmode = prod
ServerName  = "gopub"
EnableGzip 	= true
AutoRender = true
CopyRequestBody = true
EnableDocs = true
Graceful= false
SshPort = 22

EnableHTTP=true
HttpAddr=0.0.0.0

#jumpserver
#当前支持jumpserver 1.5.3版本，基于node进行服务器分组管理，成功对接后，可在项目设置页选择服务器分组，在实际部署代码才，会实时从jumpserver获取分组对应的ip地址，降低服务器扩容等对项目配置的影响
enableJumpserver = false
jumpserver = "http://jump.test.com"
jump_username = ""
jump_password = ""
jump_auth_api="/api/users/v1/auth/"
jump_grouplist_api = "/api/v1/assets/nodes/"
jump_groupid2ips_api = "/api/v1/assets/assets/?node_id=%id"

SessionOn= true
SessionGCMaxLifetime=86400
SessionCookieLifeTime=86400

#控制台登录凭据(user 表的 auth_key)有效期，单位秒，默认 604800(7 天)。
#滑动过期：有请求就顺延，闲置超过该时长后需要重新登录；登出与改密码会立即吊销。
authKeyLifetime = 604800

#上线日志(record 表与 logs/task_log 下的完整日志文件)保留天数。
#这张表每次发布都在写，不清理会一直涨，表越大上线进度页越慢。
#留空或设为 0 表示不清理；程序内置默认值也是 0，只有在这里显式配置才会启用清理。
recordKeepDays = 30

#ldap config
#为true则依赖ldap进行身份验证，如果为false，使用原数据库存储用户方式进行

enableLdap = false
ldapHost = "127.0.0.1"
ldapPort = 389
ldapPeopleDn = "ou=People,dc=test,dc=com"
#登录用户时使用
ldapPeopleDnTpl = "uid={uid},ou=People,dc=test,dc=com"
#用户组dn，在其下查找符合ldapGroupFilter的组，来判断该用户有什么权限。

ldapGroupDn = "ou=Group,dc=test,dc=com"
#查找用户所在用户组。可根据你的ldap用户组配置方式选择或调整本参数。
#会自动替换配置字段中的这些变量：{UidNumber} {uid} {cn} {sn}为当前用户的实际数据
#例1：需要有cn=gopub*,ou=Group,dc=test,dc=com的用户组entry，且其中memberUid中包含当前登录的uid
ldapGroupFilter = "(&(cn=gopub*)(memberUid={uid}}))"
#例2：用户在组中的标识为：member:uid=zhangsan,ou=People,dc=test,dc=com
#ldapGroupFilter = "(&(cn=gopub*)(member=uid={uid},ou=People,dc=test,dc=com))"
#需要在ldap中建立三个用户组，对应gopub中原有的组设置 gopubAdmin gopubPre gopubSingle
ldapGroupName2roleid_gopubAdmin = 1
ldapGroupName2roleid_gopubPre = 10
ldapGroupName2roleid_gopubSingle = 20



[dev]
HttpPort = 8192
HttpsPort=12448
AccessLogs= true
EnableAdmin= true
AdminAddr = "0.0.0.0"
AdminPort = 8196
AccessLogs= true

#数据库配置
mysqluser = "root"
mysqlpass = ""
mysqlhost = "127.0.0.1"
mysqlport = 3306
mysqldb   = "go_pub"
#连接池：常驻的空闲连接数与最大连接数
db_max_idle_conn = 30
db_max_open_conn = 100
#单条连接最长存活秒数，须小于 MySQL 的 wait_timeout(默认 28800)与中间层空闲超时
db_conn_max_lifetime = 3600
#空闲连接最长保留秒数，超时后归还给操作系统，闲时收缩连接池
db_conn_max_idle_time = 600

#p2p配置
AgentDir="agent/"
AgentDestDir="/data/Taipei-Torrent/"
#务必换成足够随机的长字符串，不要沿用模板里的占位值
SecretKey = ""

#jenkins配置
JenkinsUserName=""
JenkinsPwd=""

#邮箱配置
emailUsername = "xxxx@xxxx.com"
emailPwd = ""
emailHost = "smtp.exmail.qq.com"
emailPort = 25

