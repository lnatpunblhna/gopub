[docker]
HttpPort = 8192
HttpsPort=12448
AccessLogs= true
EnableAdmin= false
AdminAddr = "mysql"
AdminPort = 8090
AccessLogs= false

#数据库配置
#容器部署下这几项会被 MYSQL_USER / MYSQL_PASS / MYSQL_HOST / MYSQL_PORT / MYSQL_DB
#环境变量覆盖(仅 runmode=docker 生效，见 src/main.go)，这里保留可直接跑通的默认值
mysqluser = "root"
mysqlpass = "123456"
mysqlhost = "mysql"
mysqlport = 3306
mysqldb   = "walle"
#连接池：常驻的空闲连接数与最大连接数
db_max_idle_conn = 30
db_max_open_conn = 100
#单条连接最长存活秒数，须小于 MySQL 的 wait_timeout(默认 28800)与中间层空闲超时
db_conn_max_lifetime = 3600
#空闲连接最长保留秒数，超时后归还给操作系统，闲时收缩连接池
db_conn_max_idle_time = 600

#p2p配置
AgentDir="agent/"
AgentDestDir="/data/Taipei-Torrent/"
#务必换成足够随机的长字符串，不要沿用模板里的占位值
SecretKey = ""

#jenkins配置
JenkinsUserName=""
JenkinsPwd=""

#邮箱配置
emailUsername = "xxxx@xxxx.com"
emailPwd = ""
emailHost = "smtp.exmail.qq.com"
emailPort = 25
