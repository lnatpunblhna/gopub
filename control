#!/bin/bash -e
export GOROOT=/usr/local/go
export PATH=$PATH:/usr/local/go/bin/ 
DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
BASENAME=`basename $DIR`
export GO111MODULE=on

app=$BASENAME
conf=$DIR/src/conf/app.conf
conf_example=$DIR/src/conf/app.conf.example
pidfile=$DIR/$BASENAME.pid
logfile=$DIR/src/logs/stdout.log

 function check_pid() {
    if [ -f $pidfile ];then
        pid=`cat $pidfile`
        if [ -n $pid ]; then
            running=`ps -p $pid|grep -v "PID TTY" |wc -l`
            return $running
        fi
    fi
    return 0
}

# 只在 app.conf 缺失时从模板生成一次。
# 发布包与镜像里都只带 app.conf.example(见 pack 的 --exclude 与 release.yml),
# 所以升级解压不会覆盖线上已填好的 app.conf;这里负责首次部署时把模板落成可用文件。
function ensure_conf() {
    if [ -f "$conf" ]; then
        return 0
    fi
    if [ ! -f "$conf_example" ]; then
        echo "缺少配置文件 $conf,且模板 $conf_example 也不存在"
        exit 1
    fi
    cp "$conf_example" "$conf"
    echo "已从模板生成 $conf —— 首次部署请先填写数据库连接与 SecretKey 再启动"
}

function build() {
    gofmt -w $DIR/src/
    cd $DIR/src/
    # CGO_ENABLED=0 静态编译:本项目无 import "C",但只要构建机装了 gcc,cgo 就会默认开启,
    # 届时标准库 net 走 cgo 版 DNS 解析器,产物动态链接构建机的 glibc。
    # 在比构建机更老的目标机(如 glibc 2.28)上会直接报 GLIBC_2.xx not found。
    CGO_ENABLED=0 go build -o $BASENAME
    if [ $? -ne 0 ]; then
        exit $?
    fi
    # p2p 分发 agent:产物已移出版本管理(见 .gitignore),干净 clone 后必须在这里构建出来,
    # 否则 control pack 和 Dockerfile 的 COPY src/agent 都会漏掉它,SendP2pAgent 失效。
    # 同样静态编译:它会被 sftp 送到发布目标机执行,目标机 glibc 版本更加不可控。
    CGO_ENABLED=0 go build -o $DIR/src/agent/agent_main ./agent
    if [ $? -ne 0 ]; then
        exit $?
    fi
}
# 前端构建，产物写入 src/static 并刷新 src/views/index.tpl
# 注意：不要把它并入 build()，Dockerfile 的 golang 阶段会执行 ./control build，那里没有 node
function webbuild() {
    cd $DIR/frontend
    if [ ! -d node_modules ]; then
        npm ci
    fi
    npm run build
}
# 前端 + 后端完整构建，源码 clone 后首次运行请用这个
function buildall() {
    webbuild
    build
}
function pack() {
    buildall
    cd  ..
    rm  -rf $BASENAME/src/logs/*
    # --exclude 排除 app.conf:它不入 git,但开发机工作区里有一份,不排除就会被打进包,
    # 解压到目标机时覆盖掉线上配置。包里只留 app.conf.example,由 ensure_conf 首次生成
    cd  .. && tar --exclude=$BASENAME/src/conf/app.conf -zcvf $app.tar.gz $BASENAME/control $BASENAME/$app.service $BASENAME/src/$app  $BASENAME/src/conf    $BASENAME/src/logs   $BASENAME/src/agent  $BASENAME/src/views $BASENAME/src/static  $BASENAME/src/favicon.ico
}
function start() {
    check_pid
    running=$?
    if [ $running -gt 0 ];then
        echo -n "$app now is running already, pid="
        cat $pidfile
        return 1
    fi

    ensure_conf
    cd $DIR/src/
    mkdir -p $DIR/src/logs
    nohup  ./$BASENAME  >$logfile 2>&1 &
    sleep 1
    running=`ps -p $! | grep -v "PID TTY" | wc -l`
    if [ $running -gt 0 ];then
        echo $! > $pidfile
        echo "$app started..., pid=$!"
    else
        echo "$app failed to start."
        return 1
    fi


}
function killall() {
    pid=`cat $pidfile`
    ps -ef|grep $BASENAME|grep -v grep|awk '{print $2}'|xargs kill -9 
    rm -f $pidfile
    echo "$app killed..., pid=$pid"
}
function stop() {
    #ps -ef|grep $BASENAME|grep -v grep|awk '{print $2}'|xargs kill -9
    pid=`cat $pidfile`
    kill $pid
    rm -f $pidfile
    echo "$app stoped..., pid=$pid"
}
function restart() {
    stop
    sleep 1
    start 
}
function reload() { 
    pid=`cat $pidfile`
    kill -HUP $pid
    sleep 1
    newpid=`ps -ef|grep $BASENAME|grep -v grep|awk '{print $2}'` 
    echo "$app reload..., pid=$newpid"
    echo $newpid > $pidfile 
}
function status() {
    check_pid
    running=$?
    if [ $running -gt 0 ];then
        echo started
    else
        echo stoped
    fi
}
function run() {
   ensure_conf
   cd $DIR/src/
   ./$BASENAME -docker
   #go run main.go
}
function rundocker() {
   ensure_conf
   cd $DIR/src/
   ./$BASENAME -docker
   #go run main.go
}
function init() {
   ensure_conf
   cd $DIR/src/
   ./$BASENAME -syncdb
   #go run main.go
}
function tailf() {
   tail -f $logfile
}

function sslkey() {
   cd $DIR/src/conf/ssl
   ###CA:
   #私钥文件
   openssl genrsa -out ca.key 2048
}  

 
function help() {
    echo "$0 build|webbuild|buildall|pack|start|stop|kill|restart|reload|status|run|rundocker|init|tail|docs|beerun|sslkey"
}
if [ "$1" == "" ]; then
    help
elif [ "$1" == "build" ];then
    build
elif [ "$1" == "webbuild" ];then
    webbuild
elif [ "$1" == "buildall" ];then
    buildall
elif [ "$1" == "pack" ];then
    pack
elif [ "$1" == "start" ];then
    start
elif [ "$1" == "stop" ];then
    stop
elif [ "$1" == "kill" ];then
    killall
elif [ "$1" == "restart" ];then
    restart
elif [ "$1" == "reload" ];then
    reload
elif [ "$1" == "status" ];then
    status
elif [ "$1" == "run" ];then
    run
elif [ "$1" == "rundocker" ];then
    rundocker
elif [ "$1" == "init" ];then
    init
elif [ "$1" == "tail" ];then
    tailf
elif [ "$1" == "sslkey" ];then
    sslkey
else
    help
fi
